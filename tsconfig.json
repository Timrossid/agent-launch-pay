{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "noEmitOnError": true
  },
  "include": [
  "sdk/**/*.ts",
  "examples/**/*.ts",
  "tests/**/*.ts",
  "mcp-server/**/*.ts"
],
  "exclude": [
    "node_modules",
    "dist"
  ]
}